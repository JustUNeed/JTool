<jt:JTWindow x:Class="JTool.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jt="clr-namespace:JTUI.Controls;assembly=JTUI"
        Title="设置" Width="380" Height="520">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <jt:JTButton Content="切换主题" Click="ToggleTheme_Click" HorizontalAlignment="Right"/>

                <!-- 开机自启 -->
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开机自启" VerticalAlignment="Center" Grid.Column="0"/>
                    <jt:JTToggleSwitch IsChecked="{Binding AutoStart}" Grid.Column="1"/>
                </Grid>

                <!-- 总在最前 -->
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="总在最前" VerticalAlignment="Center" Grid.Column="0"/>
                    <jt:JTToggleSwitch IsChecked="{Binding Topmost}" Grid.Column="1"/>
                </Grid>


                <!-- ===== 悬浮球外观 ===== -->
                <TextBlock Text="悬浮球外观" Margin="10,14,10,4" FontWeight="Bold"
                           Foreground="#FFAAAAAA"/>


            
                <!-- 背景颜色 -->
                <Grid Margin="10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="背景颜色" VerticalAlignment="Center" Grid.Column="0"/>
                    <jt:JTTextBox Text="{Binding BallColor, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" Grid.Column="1"/>
                </Grid>


                <!-- 文字内容 -->
                <!-- 文字内容（留空则不显示） -->
                <Grid Margin="10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文字内容" VerticalAlignment="Center" Grid.Column="0"/>
                    <jt:JTTextBox Text="{Binding BallText, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" MaxLength="2" Grid.Column="1"/>
                </Grid>

                <!-- 圆角大小 -->
                <jt:JTNumberBox Value="{Binding BallCornerRadius}" Minimum="0" Maximum="100"
                                Step="1" Decimals="0" Label="圆角大小（=尺寸一半即正圆）" Margin="10,6"/>
                <!-- 悬浮球大小 -->
                <jt:JTNumberBox Value="{Binding BallSize}" Minimum="16" Maximum="100"
                    Step="1" Decimals="0" Label="悬浮球大小" Margin="10,6"/>

                <!-- 图片 -->
                <Grid Margin="10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="使用图片（优先于颜色/文字）"
                               VerticalAlignment="Center" Grid.Column="0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <jt:JTButton Content="选择" Command="{Binding PickBallImageCommand}" Padding="8,4"/>
                        <jt:JTButton Content="清除" Command="{Binding ClearBallImageCommand}"
                                     Margin="6,0,0,0" Padding="8,4"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding BallImagePath}" Margin="10,0,10,4"
                           FontSize="11" Foreground="#FF888888"
                           TextTrimming="CharacterEllipsis"/>

                <!-- ===== 其他 ===== -->
                <TextBlock Text="其他" Margin="10,14,10,4" FontWeight="Bold"
                           Foreground="#FFAAAAAA"/>

                <Grid Margin="10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="网络图片下载" VerticalAlignment="Center" Grid.Column="0"/>
                    <jt:JTToggleSwitch IsChecked="{Binding EnableImageDownload}" Grid.Column="1"/>
                </Grid>

                <jt:JTButton Content="打开配置文件夹"
                             Command="{Binding OpenConfigFolderCommand}"
                             Margin="10,8,10,0" Padding="8,4" HorizontalAlignment="Left"/>

                <jt:JTButton Content="重置窗口设置（位置/尺寸）"
                             Command="{Binding ResetWindowCommand}"
                             Margin="10,8,10,0" Padding="8,4" HorizontalAlignment="Left"/>

            </StackPanel>
        </ScrollViewer>

        <jt:JTButton Content="保存并关闭" Margin="10" Grid.Row="1"
                     HorizontalAlignment="Right" Click="SaveClose_Click"/>
    </Grid>

</jt:JTWindow>
