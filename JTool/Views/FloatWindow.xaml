<Window x:Class="JTool.Views.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        Title="JTool" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        AllowDrop="True"
        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}">

    <!-- RootGrid 自身不设大小，让内部当前可见的形态决定窗口尺寸 -->
    <Grid x:Name="RootGrid" HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- ===== 形态一：菜单 + 看板 ===== -->
        <Border x:Name="MenuPanel" Visibility="Collapsed"
                Width="{Binding PanelWidth}" Height="{Binding PanelHeight}"
                Background="#FF2D2D30" CornerRadius="12" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DragHandle" Grid.Column="0" Width="32" Height="32"
                            Background="#FF3F51B5" CornerRadius="4" Cursor="SizeAll"
                            Margin="0,0,8,0" MouseLeftButtonDown="DragHandle_MouseDown">
                        <TextBlock Text="⠿" Foreground="White" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="JTool" Foreground="#FFAAAAAA"
                               FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="⚙" Width="24" Height="24"
                            Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0"
                            Cursor="Hand" Command="{Binding OpenSettingsCommand}" ToolTip="设置"/>
                    <Button Grid.Column="3" Content="✕" Width="24" Height="24"
                            Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0"
                            Cursor="Hand" Command="{Binding ExitCommand}" ToolTip="退出"/>
                </Grid>

                <!-- 内容区：快捷 + 看板，整体在剩余高度内滚动 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 快捷宫格：按宽度自动折行 -->
                        <ItemsControl ItemsSource="{Binding Shortcuts}"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True"
                                      dd:DragDrop.DropHandler="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="4" Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" ToolTip="{Binding Path}"
                                            Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Path}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="删除"
                                                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}"
                                                   Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="28"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ===== 看板区 ===== -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasBoardItems, Converter={StaticResource BoolToVis}}">
                            <Border Height="1" Background="#FF444444" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▾" Width="20" Height="20"
                                        Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0"
                                        Cursor="Hand" ToolTip="折叠/展开"
                                        Command="{Binding DataContext.ToggleBoardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Grid.Column="1" Text="看板"
                                           Foreground="#FFAAAAAA" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Visibility="{Binding IsBoardExpanded, Converter={StaticResource BoolToVis}}">
                                <!-- 图片卡片区 -->
                                <ItemsControl ItemsSource="{Binding BoardImageItems}"
                                              Visibility="{Binding HasBoardImage, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="84" Height="84" Margin="3"
                                                    Background="#FF3A3A3D" CornerRadius="6">
                                                <Grid>
                                                    <Button Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" ToolTip="点击复制图片"
                                                            Visibility="{Binding IsImageReady, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.CopyBoardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                                    </Button>

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="⏳" FontSize="22" Foreground="#FFBBBBBB"
                                                                   HorizontalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <TextBlock.RenderTransform>
                                                                <RotateTransform x:Name="SpinTransform"/>
                                                            </TextBlock.RenderTransform>
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="SpinTransform"
                                                                                Storyboard.TargetProperty="Angle"
                                                                                From="0" To="360" Duration="0:0:1.2"
                                                                                RepeatBehavior="Forever"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="加载中" FontSize="9" Foreground="#FF999999"
                                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="⚠" FontSize="22" Foreground="#FFE57373"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="加载失败" FontSize="9" Foreground="#FFE57373"
                                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <Button Content="✕" Width="16" Height="16"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="1" Background="#88000000" Foreground="White"
                                                            BorderThickness="0" Cursor="Hand" FontSize="9" ToolTip="删除"
                                                            Command="{Binding DataContext.RemoveBoardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 文本条形列表区：限宽 + 自动换行 -->
                                <ItemsControl ItemsSource="{Binding BoardTextItems}" Margin="0,4,0,0"
                                              Visibility="{Binding HasBoardText, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Background="#FF3A3A3D" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" HorizontalContentAlignment="Left"
                                                            Padding="8,6" ToolTip="点击复制文本"
                                                            Command="{Binding DataContext.CopyBoardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Preview}" Foreground="White"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                    <Button Grid.Column="1" Content="✕" Width="22" Height="22"
                                                            Margin="2" Background="Transparent" Foreground="#FFAAAAAA"
                                                            BorderThickness="0" Cursor="Hand" FontSize="10" ToolTip="删除"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding DataContext.RemoveBoardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 右下角对角缩放手柄（跨两行，定位到右下角）-->
                <Thumb x:Name="ResizeThumb" Grid.Row="1" Width="16" Height="16"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-4,-4" Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Stroke="#FF888888" StrokeThickness="1"
                                      Data="M 14,4 L 4,14 M 14,9 L 9,14 M 14,14 L 13,14"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- ===== 形态二：拖拽槽位 ===== -->
        <Border x:Name="DropPanel" Visibility="Collapsed"
                Background="#FF2D2D30" CornerRadius="12" Padding="6" Width="130">
            <StackPanel x:Name="DropSlotsPanel"/>
        </Border>

        <!-- ===== 形态零：悬浮球 ===== -->
        <Border x:Name="BallPanel" Width="32" Height="32"
                Background="#FF3F51B5" Cursor="Hand" MouseEnter="Ball_MouseEnter">
            <TextBlock Text="J" Foreground="White" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
