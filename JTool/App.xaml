<Application x:Class="JTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="JTool 悬浮工具"
                        DoubleClickCommand="{Binding ToggleVisibilityCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示 / 隐藏悬浮球"
                              Command="{Binding ToggleVisibilityCommand}"/>
                    <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="退出 JTool" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
