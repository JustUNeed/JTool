<jt:JTWindow x:Class="JTool.Hosting.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JTool.Hosting"
        xmlns:tb="clr-namespace:JTool.Widgets.TextBoard"
       xmlns:jt="clr-namespace:JTUI.Controls;assembly=JTUI"
       xmlns:img="clr-namespace:JTUI.Controls.ImageGrid;assembly=JTUI"
       xmlns:file="clr-namespace:JTUI.Controls.FileGrid;assembly=JTUI"
       xmlns:folder="clr-namespace:JTUI.Controls.FolderBin;assembly=JTUI"
            xmlns:tl="clr-namespace:JTUI.Controls.TextList;assembly=JTUI"
 

             
       
        ShowInTaskbar="False" Topmost="True" AllowDrop="True"
        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}"
        
             
         TitleBarMode="NoTitleBar"
        
        
        
        >


    <Grid >

    
              
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <!-- 顶栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DragHandle" Grid.Column="0" Width="32" Height="32"
            Background="#FF3F51B5" CornerRadius="4" Cursor="SizeAll"
            Margin="0,0,8,0" MouseLeftButtonDown="DragHandle_MouseDown">
                        <TextBlock Text="⠿" Foreground="White" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="JTool" Foreground="#FFAAAAAA"
               FontSize="12" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="2" Width="24" Height="24" Cursor="Hand"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#FFAAAAAA"
                  IsChecked="{Binding IsPinned}"
                  ToolTip="常驻（不自动收起）" Content="📌"/>
                    <Button Grid.Column="3" Content="⚙" Width="24" Height="24" Cursor="Hand"
            Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0"
            Command="{Binding OpenSettingsCommand}" ToolTip="设置"/>
                    <Button Grid.Column="4" Content="✕" Width="24" Height="24" Cursor="Hand"
            Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0"
            Command="{Binding ExitCommand}" ToolTip="退出"/>
                </Grid>


                <!-- 三大控件平分主内容区 -->
                <!-- 四大控件平分主内容区 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <!-- 文件夹收纳 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 文件网格 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 图片瀑布流(占主要空间) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 图片瀑布流(占主要空间) -->
                    <RowDefinition Height="*"/>



                </Grid.RowDefinitions>

                <!-- 文件夹收纳条 -->

                <Border   Grid.Row="0"  Background="#2a2a2a"  CornerRadius="4" Margin="8,2">
                    <folder:JTFolderBin x:Name="Bin" 
                            Grid.Row="2"
                         MaxRows="2"
                            ItemWidth="80" ItemHeight="40"
                            ItemSpacing="4"
                            ShowDeleteButton="True"
                            AllowReorder="True"/>
                </Border>
                <Border   Grid.Row="1"  Background="#2a2a2a"  CornerRadius="4" Margin="8,2">
                    <!-- 文件网格 -->
                    <file:JTFileGrid x:Name="Files"
                        
                         MaxRows="3"
                      
                         ColumnWidth="80" IconSize="32" ItemSpacing="2"
                         ShowDeleteButton="True"
                         AllowDropImport="True"/>
                </Border>
                <!-- 图片 -->
                <Border   Grid.Row="2" Background="#2a2a2a" CornerRadius="4" Margin="8,2">
                    <img:JTImageGrid x:Name="ImageGrid" 
                        
                          MaxRows="3"
                         AllowDragOut="True"
                         AllowDropImport="True"
                         ColumnWidth="80"
                         ThumbnailSize="80"
                         ItemSpacing="2"
                         ShowDeleteButton="True"/>
                </Border>
                <Border   Grid.Row="3" Background="#2a2a2a" CornerRadius="4" Margin="8,2">
                    <tl:JTTextList x:Name="TextList"
                
                        MaxRows="20"
                   ShowDeleteButton="True"
                   AllowDropImport="True"
                   AllowReorder="True"
                   EmptyHint="拖入文本"/>
                </Border>

            </Grid>


                <!-- 缩放手柄 -->
                <Thumb x:Name="ResizeThumb" Grid.Row="1" Width="16" Height="16"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-4,-4" Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Stroke="#FF888888" StrokeThickness="1"
                                      Data="M 14,4 L 4,14 M 14,9 L 9,14 M 14,14 L 13,14"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        <!-- 面板内容根容器，起名 PanelRoot -->
        <Grid x:Name="PanelRoot">
            <!-- 顶栏 + 四个控件 + ResizeThumb，保持原样 -->
        </Grid>

        <!-- 形态：悬浮球 -->
        <Border x:Name="BallPanel" Width="32" Height="32"
                Background="#FF3F51B5" Cursor="Hand" MouseEnter="Ball_MouseEnter">
            <TextBlock Text="J" Foreground="White" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</jt:JTWindow>
