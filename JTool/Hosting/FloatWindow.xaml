<jt:JTWindow x:Class="JTool.Hosting.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jt="clr-namespace:JTUI.Controls;assembly=JTUI"
        xmlns:img="clr-namespace:JTUI.Controls.ImageGrid;assembly=JTUI"
        xmlns:file="clr-namespace:JTUI.Controls.FileGrid;assembly=JTUI"
        xmlns:folder="clr-namespace:JTUI.Controls.FolderBin;assembly=JTUI"
        xmlns:tl="clr-namespace:JTUI.Controls.TextList;assembly=JTUI"
             
        ShowInTaskbar="False" Topmost="True" AllowDrop="True"
        SizeToContent="Manual"
        TitleBarMode="NoTitleBar"
        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}"
             Background="Transparent"         AllowsTransparency="True"
             >

    <Grid>
        <!-- ===== 面板形态 ===== -->
        <Border x:Name="PanelRootBackground" Background="{DynamicResource JT.Window.Background}" CornerRadius="9" Visibility="Collapsed" >
        <Grid x:Name="PanelRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 顶栏，高=图标大小 -->
                <RowDefinition Height="*"/>
                <!-- 内容区 -->
            </Grid.RowDefinitions>

            <!-- 顶栏：高度=图标大小，第一列给拖动块，其余水平排 -->
            <Grid x:Name="TopBar" Grid.Row="0" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DragSlot" Width="32"/>
                    <!-- 宽=图标大小 -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 拖动块：占满第一列，和悬浮球同位同大小 -->
                    <Border x:Name="DragHandle" Grid.Column="0"
        Cursor="SizeAll"
        MouseLeftButtonDown="DragHandle_MouseDown">
                        <TextBlock x:Name="DragTextBlock" Foreground="White"
               FontWeight="Bold"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>


                  

                    <jt:JTIconToggleButton Grid.Column="2"  Cursor="Hand" VerticalAlignment="Top"
                          
                              IsChecked="{Binding IsPinned}" ToolTip="常驻（不自动收起）" >

                        <Path Stretch="Uniform" Width="16" Height="16"
          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Control}}"
          Data="M235.32,81.37 174.63,20.69 a16,16,0,0,0-22.63,0 L98.37,74.49 c-10.66-3.34-35-7.37-60.4,13.14 a16,16,0,0,0-1.29,23.78 L85,159.71 42.34,202.34 a8,8,0,0,0,11.32,11.32 L96.29,171 l48.29,48.29 A16,16,0,0,0,155.9,224 c.38,0,.75,0,1.13,0 a15.93,15.93,0,0,0,11.64-6.33 c19.64-26.1,17.75-47.32,13.19-60 L235.33,104 A16,16,0,0,0,235.32,81.37 Z M224,92.69 h0 l-57.27,57.46 a8,8,0,0,0-1.49,9.22 c9.46,18.93-1.8,38.59-9.34,48.62 L48,100.08 c12.08-9.74,23.64-12.31,32.48-12.31 A40.13,40.13,0,0,1,96.81,91 a8,8,0,0,0,9.25-1.51 L163.32,32 224,92.68 Z"/>
                    </jt:JTIconToggleButton>







                    <jt:JTIconButton Grid.Column="3"   Cursor="Hand"  VerticalAlignment="Top"
                       
                     
                        Command="{Binding OpenSettingsCommand}" ToolTip="设置">

                        <Path Stretch="Uniform" Width="16" Height="16"
          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Control}}"
          Data="M128,80 a48,48,0,1,0,48,48 A48.05,48.05,0,0,0,128,80 Z m0,80 a32,32,0,1,1,32-32 A32,32,0,0,1,128,160 Z m109.94-52.79 a8,8,0,0,0-3.89-5.4 l-29.83-17-.12-33.62 a8,8,0,0,0-2.83-6.08 111.91,111.91,0,0,0-36.72-20.67 8,8,0,0,0-6.46.59 L128,41.85 97.88,25 a8,8,0,0,0-6.47-.6 A112.1,112.1,0,0,0,54.73,45.15 a8,8,0,0,0-2.83,6.07 l-.15,33.65-29.83,17 a8,8,0,0,0-3.89,5.4 106.47,106.47,0,0,0,0,41.56 8,8,0,0,0,3.89,5.4 l29.83,17,.12,33.62 a8,8,0,0,0,2.83,6.08 111.91,111.91,0,0,0,36.72,20.67 8,8,0,0,0,6.46-.59 L128,214.15 158.12,231 a7.91,7.91,0,0,0,3.9,1 8.09,8.09,0,0,0,2.57-.42 112.1,112.1,0,0,0,36.68-20.73 8,8,0,0,0,2.83-6.07 l.15-33.65,29.83-17 a8,8,0,0,0,3.89-5.4 A106.47,106.47,0,0,0,237.94,107.21 Z m-15,34.91-28.57,16.25 a8,8,0,0,0-3,3 c-.58,1-1.19,2.06-1.81,3.06 a7.94,7.94,0,0,0-1.22,4.21 l-.15,32.25 a95.89,95.89,0,0,1-25.37,14.3 L134,199.13 a8,8,0,0,0-3.91-1 h-.19 c-1.21,0-2.43,0-3.64,0 a8.08,8.08,0,0,0-4.1,1 l-28.84,16.1 A96,96,0,0,1,67.88,201 l-.11-32.2 a8,8,0,0,0-1.22-4.22 c-.62-1-1.23-2-1.8-3.06 a8.09,8.09,0,0,0-3-3.06 l-28.6-16.29 a90.49,90.49,0,0,1,0-28.26 L61.67,97.63 a8,8,0,0,0,3-3 c.58-1,1.19-2.06,1.81-3.06 a7.94,7.94,0,0,0,1.22-4.21 l.15-32.25 a95.89,95.89,0,0,1,25.37-14.3 L122,56.87 a8,8,0,0,0,4.1,1 c1.21,0,2.43,0,3.64,0 a8.08,8.08,0,0,0,4.1-1 l28.84-16.1 A96,96,0,0,1,188.12,55 l.11,32.2 a8,8,0,0,0,1.22,4.22 c.62,1,1.23,2,1.8,3.06 a8.09,8.09,0,0,0,3,3.06 l28.6,16.29 A90.49,90.49,0,0,1,222.9,142.12 Z"/>
                    </jt:JTIconButton>



                    <jt:JTIconButton Grid.Column="4"  Cursor="Hand"  VerticalAlignment="Top"
                        
                       
                        Command="{Binding ExitCommand}" ToolTip="退出">

                        <Path Stretch="Uniform" Width="13" Height="13"
      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Control}}"
      Data="M205.66,194.34 a8,8,0,0,1-11.32,11.32 L128,139.31 61.66,205.66 a8,8,0,0,1-11.32-11.32 L116.69,128 50.34,61.66 A8,8,0,0,1,61.66,50.34 L128,116.69 l66.34-66.35 a8,8,0,0,1,11.32,11.32 L139.31,128 Z"/>   </jt:JTIconButton>

                </Grid>

            <!-- 内容区：四个控件从上往下垂直排 -->
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource JTUI.Background}" CornerRadius="4" Margin="8,2">
                    <folder:JTFolderBin x:Name="Bin" MaxRows="2"
                                        ItemWidth="80" ItemHeight="40" ItemSpacing="4"
                                        ShowDeleteButton="True" AllowReorder="True"/>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource JTUI.Background}" CornerRadius="4" Margin="8,2">
                    <file:JTFileGrid x:Name="Files" MaxRows="3"
                                     ColumnWidth="80" IconSize="32" ItemSpacing="2"
                                     ShowDeleteButton="True" AllowDropImport="True"/>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource JTUI.Background}" CornerRadius="4" Margin="8,2">
                    <img:JTImageGrid x:Name="ImageGrid" MaxRows="3"
                                     AllowDragOut="True" AllowDropImport="True"
                                     ColumnWidth="80" ThumbnailSize="80" ItemSpacing="2"
                                     ShowDeleteButton="True"/>
                </Border>
                <Border Grid.Row="3" Background="{DynamicResource JTUI.Background}" CornerRadius="4" Margin="8,2">
                    <tl:JTTextList x:Name="TextList" MaxRows="20"
                                   ShowDeleteButton="True" AllowDropImport="True"
                                   AllowReorder="True" EmptyHint="拖入文本"/>
                </Border>
            </Grid>

            <!-- 缩放手柄：贴 PanelRoot 右下角 -->
            <Thumb x:Name="ResizeThumb" Grid.Row="1" Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,2,2" Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Stroke="#FF888888" StrokeThickness="1"
                                  Data="M 14,4 L 4,14 M 14,9 L 9,14 M 14,14 L 13,14"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
        </Border>
        <!-- ===== 悬浮球形态 ===== -->
        <Border x:Name="BallPanel"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Width="32" Height="32"
        Background="#FF3F51B5" Cursor="Hand"
        MouseEnter="Ball_MouseEnter"
        MouseLeftButtonDown="DragHandle_MouseDown">
            <Grid>
                <Image x:Name="BallImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                <TextBlock x:Name="BallTextBlock" Text="J" Foreground="White"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>

</jt:JTWindow>
